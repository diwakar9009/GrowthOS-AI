# GEMINI_API_KEY: Required for Gemini AI API calls.
# On Vercel, add this to your Project Settings > Environment Variables.
GEMINI_API_KEY="your_api_key_here"

# APP_URL: The URL where this app is hosted.
# On Vercel, this is your deployment URL (e.g., https://my-app.vercel.app)
APP_URL="https://your-app.vercel.app"

# Vercel Deployment Note:
# 1. Add GEMINI_API_KEY to Vercel Environment Variables.
# 2. Add your Vercel domain to Firebase Console > Authentication > Settings > Authorized Domains.
# 3. Ensure vercel.json is present for SPA routing.
