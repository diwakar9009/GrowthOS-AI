{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about the freelancer/assistant user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "niche": { "type": "string" },
        "platform": { "type": "string", "enum": ["instagram", "youtube", "both"] },
        "streak": { "type": "number" },
        "lastActive": { "type": "string", "format": "date-time" },
        "points": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "streak", "points", "createdAt"]
    },
    "Task": {
      "title": "Task/Tool Usage",
      "description": "A generated content task or tool interaction",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "clientId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["caption", "trend", "suggestion", "tool"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "type", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "description": "A client managed by the freelancer",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "niche": { "type": "string" },
        "brandVoice": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "on-hold", "completed"] },
        "progress": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "status", "createdAt"]
    },
    "Project": {
        "title": "Project",
        "description": "A project or campaign for a client",
        "type": "object",
        "properties": {
            "userId": { "type": "string" },
            "clientId": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "status": { "type": "string", "enum": ["todo", "in-progress", "review", "done"] },
            "priority": { "type": "string", "enum": ["low", "medium", "high"] },
            "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["userId", "title", "status", "createdAt"]
    },
    "Asset": {
        "title": "Brand Asset",
        "description": "Files, links, or media for brand management",
        "type": "object",
        "properties": {
            "userId": { "type": "string" },
            "clientId": { "type": "string" },
            "name": { "type": "string" },
            "type": { "type": "string", "enum": ["image", "video", "doc", "link"] },
            "url": { "type": "string", "format": "uri" },
            "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["userId", "name", "type", "url", "createdAt"]
    },
    "SuiteHubGAEvent": {
      "title": "SuiteHub GA Event",
      "description": "A Google Analytics simulated real-time telemetry event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "url": { "type": "string" },
        "country": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "url", "country", "time", "status", "createdAt"]
    },
    "SuiteHubPixel": {
      "title": "SuiteHub Pixel",
      "description": "An installed tracking pixel container",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdAt"]
    },
    "SuiteHubBrevoChat": {
      "title": "SuiteHub Brevo Chat Message",
      "description": "A message in the Brevo live customer chat inbox",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string", "enum": ["customer", "agent"] },
        "text": { "type": "string" },
        "time": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sender", "text", "time", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks and AI interactions"
    },
    "/users/{userId}/clients/{clientId}": {
      "schema": "Client",
      "description": "Client data"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Campaigns and projects"
    },
    "/users/{userId}/assets/{assetId}": {
      "schema": "Asset",
      "description": "Brand assets"
    },
    "/users/{userId}/suitehub_ga_events/{eventId}": {
      "schema": "SuiteHubGAEvent",
      "description": "Google Analytics telemetry events"
    },
    "/users/{userId}/suitehub_pixels/{pixelId}": {
      "schema": "SuiteHubPixel",
      "description": "Installed third-party tracking pixels"
    },
    "/users/{userId}/suitehub_brevo_chats/{chatId}": {
      "schema": "SuiteHubBrevoChat",
      "description": "Brevo inbox live chat interactions"
    }
  }
}
